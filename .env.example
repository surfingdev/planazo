# Copiá este archivo como .env.local y completá lo que necesites.
# .env.local nunca se comparte y nunca se sube a ningún lado.

# ---------------------------------------------------------------- la función de IA
# Hace falta UNA de las dos para que ande el botón "Sugerime el próximo plan".
# El resto de la app funciona igual sin ninguna.

# Opción 1: OpenRouter. Una llave para muchos modelos. openrouter.ai/keys
OPENROUTER_API_KEY=
# Opcional. Si el modelo de abajo no existe más, cambialo por otro de la lista
# de openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Opción 2: Anthropic directo. console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------------- base de datos
# Si esto está vacío, la app usa SQLite en data/planazo.db y no necesitás nada.
# Cuando publiques en Vercel, pegá acá la dirección de un Postgres (Neon,
# Vercel Postgres o Supabase) y la app cambia de base sola.
# DATABASE_URL=
